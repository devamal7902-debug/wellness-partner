# ==========================================
# Expo App Configuration (loaded at build & config time)
# ==========================================
APP_NAME=wellness-partner
APP_SLUG=wellness-partner
APP_SCHEME=wellnesspartner
APP_VERSION=1.0.0
ANDROID_PACKAGE=com.anonymous.wellnesspartner
IOS_BUNDLE_IDENTIFIER=com.anonymous.wellnesspartner

# ==========================================
# Client Environment Variables (accessible via process.env.EXPO_PUBLIC_*)
# Note: Variables MUST start with EXPO_PUBLIC_ to be accessible in client-side code!
# DO NOT store sensitive private keys or secrets here.
# ==========================================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_ENABLE_ANALYTICS=false
